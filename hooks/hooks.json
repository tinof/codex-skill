{
  "description": "Automatic plan review — sends Claude Code plans to Codex for a second opinion",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "CODEX_SKILL_PLAN_REVIEW=revise CODEX_SKILL_MODEL=gpt-6-astra CODEX_SKILL_EFFORT=medium bash ${CLAUDE_PLUGIN_ROOT}/hooks/plan-review.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
